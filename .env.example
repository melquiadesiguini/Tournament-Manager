# Copiar este archivo como .env.local y completar con los datos de tu proyecto de
# Supabase (Project Settings > API). .env.local NO se sube a git.

# URL del proyecto, por ejemplo https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# Clave pública ("anon" / "publishable"). NO usar la clave "service_role".
VITE_SUPABASE_ANON_KEY=
